# ----------------------------------------------------------------------
# Deccan Imperia — Apache / LiteSpeed Configuration for Hostinger
# ----------------------------------------------------------------------

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect /index.html to /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
    RewriteRule ^index\.html$ / [R=301,L]

    # Clean extensionless URLs (e.g. /about -> about.html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# MIME Types
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType application/pdf .pdf
    AddType video/mp4 .mp4
    AddType image/svg+xml .svg
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Caching Headers
<IfModule mod_headers.c>
    # Revalidate HTML, CSS, JS instantly for fast updates
    <FilesMatch "\.(html|htm|css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Cache immutable media, images, fonts, pdfs
    <FilesMatch "\.(webp|png|jpg|jpeg|gif|ico|svg|woff2|woff|ttf|eot|pdf|mp4)$">
        Header set Cache-Control "public, max-age=604800, immutable"
    </FilesMatch>
</IfModule>
